#!/usr/bin/env python3
"""
Red Brixen Security - rb-chain
Engagement-local exploit chain tracker for RB-OPS.
Select --engagement NAME or use the active tmux session; stores data in:
  $PENTEST_BASE/<session>/.redbrixen/opskit.db
"""

from __future__ import annotations

import argparse
import json
import sqlite3
import sys
from pathlib import Path

from rb_ops import lifecycle
from rb_ops.database import atomic
from rb_ops.context import engagement_context, invocation, add_engagement_option
from rb_ops.database import open_database, migrate as init_db
from rb_exports import add_export_options, client_draft, export_path, write_export



def fail(msg: str) -> None:
    print(f"[!] {msg}", file=sys.stderr)
    sys.exit(1)


def connect() -> sqlite3.Connection:
    return open_database(engagement_context()[2])


def next_order(conn: sqlite3.Connection) -> int:
    row = conn.execute("SELECT COALESCE(MAX(step_order), 0) + 1 AS next_step FROM exploit_chain_steps").fetchone()
    return int(row["next_step"])


def add_step(args: argparse.Namespace) -> None:
    conn = connect()
    with atomic(conn):
        step_order = args.order if args.order is not None else next_order(conn)
        lifecycle.create_record(conn, 'chain', dict(step_order=step_order, title=args.title,
            tactic=args.tactic, host=args.host, command=args.command, outcome=args.outcome,
            evidence_path=args.evidence, notes=args.notes))
    print(f"[+] Added chain step {step_order}.")


def list_steps(_: argparse.Namespace) -> None:
    conn = connect()
    rows = conn.execute("SELECT * FROM exploit_chain_steps ORDER BY step_order, id").fetchall()
    if not rows:
        print("[*] No exploit chain steps found.")
        return
    for r in rows:
        print(f"[{r['id']}] step={r['step_order']} | {r['title']} | tactic={r['tactic'] or '-'} | host={r['host'] or '-'}")
        if r["command"]:
            print(f"    command: {r['command']}")
        if r["outcome"]:
            print(f"    outcome: {r['outcome']}")
        if r["evidence_path"]:
            print(f"    evidence: {r['evidence_path']}")
        if r["notes"]:
            print(f"    notes: {r['notes']}")


def update_step(args: argparse.Namespace) -> None:
    fields = {key: value for key, value in {
        'step_order': args.order, 'title': args.title, 'tactic': args.tactic, 'host': args.host,
        'command': args.command, 'outcome': args.outcome, 'evidence_path': args.evidence,
        'notes': args.notes}.items() if value is not None}
    lifecycle.update_record(connect(), 'chain', args.step_id, fields)
    print(f"[+] Updated step {args.step_id}.")


def show_history(args):
    print(json.dumps(lifecycle.history(connect(), 'chain', args.step_id), indent=2, ensure_ascii=False))


def export_markdown(args: argparse.Namespace) -> None:
    session, engagement_dir, _ = engagement_context()
    conn = connect()
    out_path = export_path(args, engagement_dir, "attack_chain")
    if not args.restricted:
        write_export(out_path, client_draft(conn, "attack_chain"), restricted=False)
        print("[+] Client draft exported; review and complete before delivery.")
        return
    rows = conn.execute("SELECT * FROM exploit_chain_steps ORDER BY step_order, id").fetchall()
    lines = [f"# Attack Chain - {session}", ""]
    if not rows:
        lines.append("No exploit chain steps recorded.")
    else:
        for r in rows:
            lines.append(f"## Step {r['step_order']}: {r['title']}")
            lines.append(f"- Tactic: {r['tactic'] or '-'}")
            lines.append(f"- Host: {r['host'] or '-'}")
            if r['command']:
                lines.append("- Command:")
                lines.append("```text")
                lines.append(r['command'])
                lines.append("```")
            lines.append(f"- Outcome: {r['outcome'] or '-'}")
            lines.append(f"- Evidence: {r['evidence_path'] or '-'}")
            if r['notes']:
                lines.append(f"- Notes: {r['notes']}")
            lines.append("")
    write_export(out_path, "\n".join(lines), restricted=True)
    print(f"[+] Exported attack chain markdown: {out_path}")


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(description="Red Brixen exploit chain tracker.")
    add_engagement_option(p)
    sub = p.add_subparsers(dest="command", required=True)

    add = sub.add_parser("add", help="Add a chain step")
    add.add_argument("title")
    add.add_argument("--order", type=int)
    add.add_argument("--tactic", default="")
    add.add_argument("--host", default="")
    add.add_argument("--command", default="")
    add.add_argument("--outcome", default="")
    add.add_argument("--evidence", default="")
    add.add_argument("--notes", default="")
    add.set_defaults(func=add_step)

    ls = sub.add_parser("list", help="List chain steps")
    ls.set_defaults(func=list_steps)

    upd = sub.add_parser("update", help="Update a chain step")
    upd.add_argument("step_id", type=int)
    upd.add_argument("--order", type=int)
    upd.add_argument("--title")
    upd.add_argument("--tactic")
    upd.add_argument("--host")
    upd.add_argument("--command")
    upd.add_argument("--outcome")
    upd.add_argument("--evidence")
    upd.add_argument("--notes")
    upd.set_defaults(func=update_step)

    hist = sub.add_parser('history', help='Display private chain edit history')
    hist.add_argument('step_id', type=int)
    hist.set_defaults(func=show_history)

    exp = sub.add_parser("export", help="Export chain to markdown")
    add_export_options(exp)
    exp.set_defaults(func=export_markdown)
    return p


def main() -> None:
    parser = build_parser()
    args = parser.parse_args()
    with invocation(args.engagement):
        args.func(args)


if __name__ == "__main__":
    try:
        main()
    except (ValueError, OSError, sqlite3.Error):
        fail("Export or database operation failed; check data, output path and permissions.")
