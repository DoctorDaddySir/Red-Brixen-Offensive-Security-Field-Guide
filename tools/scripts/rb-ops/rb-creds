#!/usr/bin/env python3
"""
Red Brixen Security - rb-creds
Engagement-local credential manager for RB-OPS.
Select --engagement NAME or use the active tmux session; stores data in:
  $PENTEST_BASE/<session>/.redbrixen/opskit.db
"""

from __future__ import annotations

import argparse
import getpass
import warnings
import sqlite3
import sys
from datetime import datetime, timezone
from pathlib import Path

from rb_ops.context import engagement_context, invocation, add_engagement_option
from rb_ops.database import open_database, migrate as init_db
import rb_credentials as vault
from rb_exports import add_export_options, client_draft, export_path, write_export



def fail(msg: str) -> None:
    print(f"[!] {msg}", file=sys.stderr)
    sys.exit(1)


def connect() -> sqlite3.Connection:
    return open_database(engagement_context()[2])


def add_credential(args: argparse.Namespace) -> None:
    _, _, db_path = engagement_context()
    key = vault.cipher(db_path)
    # getpass must fail closed rather than falling back to echoed stdin.
    with warnings.catch_warnings():
        warnings.simplefilter('error', getpass.GetPassWarning)
        secret = getpass.getpass('Credential secret: ')
    conn = connect()
    now = datetime.now(timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z")
    with conn:
        conn.execute('BEGIN IMMEDIATE')
        vault.check_secrets(conn, key)
        cursor = conn.execute(
            """INSERT INTO credentials
            (username, secret, kind, host, service, source, notes, validated, created_at)
            VALUES (?, '', ?, ?, ?, ?, ?, 0, ?)""",
            (args.username, args.kind, args.host, args.service, args.source, args.notes, now))
        identifier = cursor.lastrowid
        conn.execute('INSERT INTO credential_secrets VALUES (?,1,?)',
                     (identifier, vault.seal(key, identifier, secret)))
    print("[+] Credential added (protected).")


def list_credentials(args: argparse.Namespace) -> None:
    conn = connect()
    query = "SELECT * FROM credentials"
    params = []
    if args.validated_only:
        query += " WHERE validated = 1"
    query += " ORDER BY id"
    rows = conn.execute(query, params).fetchall()
    if not rows:
        print("[*] No credentials found.")
        return
    secrets = {}
    if args.show_secrets:
        key = vault.cipher(engagement_context()[2])
        vault.check_secrets(conn, key)
        secrets = {r["id"]: vault.reveal(conn, r["id"], key) for r in rows}
    for r in rows:
        state = "validated" if r["validated"] else "unvalidated"
        print(f"[{r['id']}] {r['username']} | kind={r['kind']} | host={r['host'] or '-'} | service={r['service'] or '-'} | {state}")
        if args.show_secrets:
            print(f"    secret: {secrets[r['id']]}")
        if r["source"]:
            print(f"    source: {r['source']}")
        if r["notes"]:
            print(f"    notes: {r['notes']}")


def validate_credential(args: argparse.Namespace) -> None:
    conn = connect()
    row = conn.execute("SELECT id FROM credentials WHERE id = ?", (args.credential_id,)).fetchone()
    if not row:
        fail(f"Credential id {args.credential_id} not found.")
    now = datetime.now(timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z")
    conn.execute("UPDATE credentials SET validated = 1 WHERE id = ?", (args.credential_id,))
    conn.execute(
        """
        INSERT INTO credential_validations (credential_id, host, service, notes, created_at)
        VALUES (?, ?, ?, ?, ?)
        """,
        (args.credential_id, args.host, args.service, args.notes, now),
    )
    conn.commit()
    print("[+] Credential validation recorded.")


def export_markdown(args: argparse.Namespace) -> None:
    vault.validate_secret_export(args)
    session, engagement_dir, db_path = engagement_context()
    conn = connect()
    out_path = export_path(args, engagement_dir, "credentials")
    if not args.restricted:
        write_export(out_path, client_draft(conn, "credentials"), restricted=False)
        print("[+] Client draft exported; review and complete before delivery.")
        return

    creds = conn.execute("SELECT * FROM credentials ORDER BY id").fetchall()
    vals = conn.execute("SELECT * FROM credential_validations ORDER BY credential_id, id").fetchall()
    vals_by_cred: dict[int, list[sqlite3.Row]] = {}
    for v in vals:
        vals_by_cred.setdefault(v["credential_id"], []).append(v)

    lines = [f"# Credentials - {session}", ""]
    if not creds:
        lines.append("No credentials recorded.")
    else:
        for c in creds:
            lines.append(f"## [{c['id']}] {c['username']}")
            lines.append(f"- Kind: {c['kind']}")
            secret = vault.export_secret(conn, c["id"], args, db_path)
            lines.append(f"- Secret: `{secret}`")
            lines.append(f"- Host: {c['host'] or '-'}")
            lines.append(f"- Service: {c['service'] or '-'}")
            lines.append(f"- Source: {c['source'] or '-'}")
            lines.append(f"- Validated: {'Yes' if c['validated'] else 'No'}")
            lines.append(f"- Created: {c['created_at']}")
            if c['notes']:
                lines.append(f"- Notes: {c['notes']}")
            if vals_by_cred.get(c['id']):
                lines.append("- Validation Events:")
                for v in vals_by_cred[c['id']]:
                    lines.append(f"  - {v['created_at']} | host={v['host'] or '-'} | service={v['service'] or '-'} | {v['notes'] or '-'}")
            lines.append("")

    write_export(out_path, "\n".join(lines), restricted=True)
    print(f"[+] Exported credential markdown: {out_path}")


def manage_storage(args):
    _, _, db_path = engagement_context()
    if args.command == 'init-key':
        vault.create_key(db_path)
        print('[+] External key created. Back it up separately before storing secrets.')
        return
    key = vault.cipher(db_path)
    if args.command == 'restore':
        vault.restore(key, args.input, db_path)
        print('[+] Database restored. Legacy backups require explicit migration.')
        return
    conn = connect()
    try:
        if args.command == 'backup':
            vault.check_secrets(conn, key, allow_legacy=True)
            vault.backup(conn, key, args.output)
            print('[+] Encrypted database backup created; keep its key separately.')
        else:
            changed = vault.migrate(conn, key, args.backup)
            print('[+] Credentials protected; review old copies and storage snapshots.' if changed
                  else '[*] No plaintext credentials to migrate.')
    finally:
        conn.close()


class PrivateArgumentParser(argparse.ArgumentParser):
    def error(self, message):
        # argparse includes rejected positional values in its default error.
        self.print_usage(sys.stderr)
        self.exit(2, '[!] Invalid arguments; secrets must be entered at the hidden prompt. See --help.\n')


def build_parser() -> argparse.ArgumentParser:
    p = PrivateArgumentParser(description="Red Brixen engagement credential manager.")
    add_engagement_option(p)
    sub = p.add_subparsers(dest="command", required=True)

    add = sub.add_parser("add", help="Add a credential")
    add.add_argument("username")
    add.add_argument("--kind", default="password")
    add.add_argument("--host", default="")
    add.add_argument("--service", default="")
    add.add_argument("--source", default="")
    add.add_argument("--notes", default="")
    add.set_defaults(func=add_credential)

    ls = sub.add_parser("list", help="List credentials")
    ls.add_argument("--show-secrets", action="store_true")
    ls.add_argument("--validated-only", action="store_true")
    ls.set_defaults(func=list_credentials)

    val = sub.add_parser("validate", help="Record a validation event")
    val.add_argument("credential_id", type=int)
    val.add_argument("--host", default="")
    val.add_argument("--service", default="")
    val.add_argument("--notes", default="")
    val.set_defaults(func=validate_credential)

    exp = sub.add_parser("export", help="Export credentials to markdown")
    add_export_options(exp)
    vault.add_secret_export_option(exp)
    exp.set_defaults(func=export_markdown)
    for name in ('init-key', 'migrate', 'backup', 'restore'):
        command = sub.add_parser(name, help='Manage protected credential storage')
        if name == 'migrate':
            command.add_argument('--backup', required=True, help='New encrypted pre-migration backup path')
        elif name == 'backup':
            command.add_argument('--output', required=True)
        elif name == 'restore':
            command.add_argument('--input', required=True)
        command.set_defaults(func=manage_storage)
    return p


def main() -> None:
    parser = build_parser()
    args = parser.parse_args()
    with invocation(args.engagement):
        args.func(args)


if __name__ == "__main__":
    try:
        main()
    except (ValueError, OSError, sqlite3.Error, getpass.GetPassWarning, EOFError, ImportError):
        fail("Credential operation failed; check migration, key/dependencies, terminal, data and private paths.")
