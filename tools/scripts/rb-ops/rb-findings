#!/usr/bin/env python3
"""
Red Brixen Security - rb-findings
Interactive findings tracker for RB-OPS.
Select --engagement NAME or use the active tmux session; stores data in:
  $PENTEST_BASE/<session>/.redbrixen/opskit.db
"""

from __future__ import annotations

import argparse
import json
import sqlite3
import sys
from pathlib import Path

from rb_ops import lifecycle
from rb_ops.scoring import cvss_base_score, severity_label
from rb_finding_model import init_details, decode, save_details, read_details, detail_lines
from rb_ops.context import engagement_context, invocation, add_engagement_option
from rb_ops.database import open_database, migrate as init_db
from rb_exports import add_export_options, client_draft, export_path, write_export



def fail(msg: str) -> None:
    print(f"[!] {msg}", file=sys.stderr)
    sys.exit(1)


def connect() -> sqlite3.Connection:
    return open_database(engagement_context()[2])


def ask(prompt: str, default: str = "") -> str:
    suffix = f" [{default}]" if default else ""
    value = input(f"{prompt}{suffix}: ").strip()
    return value or default


def ask_choice(prompt: str, valid: tuple[str, ...], default: str) -> str:
    valid_display = "/".join(valid)
    while True:
        v = ask(f"{prompt} ({valid_display})", default).upper()
        if v in valid:
            return v
        print(f"[!] Choose one of: {valid_display}")


def interactive_add(_: argparse.Namespace) -> None:
    session, _, _ = engagement_context()
    conn = connect()

    print(f"[*] Red Brixen Security | finding entry for session: {session}")
    title = ask("Finding title")
    if not title:
        fail("Title is required.")
    description = ask("Basic description")
    if not description:
        fail("Description is required.")
    host = ask("Affected host / scope item", "")

    print("\n[*] Answer CVSS v3.1 base metric questions.")
    vector = {
        "AV": ask_choice("Attack Vector", ("N", "A", "L", "P"), "N"),
        "AC": ask_choice("Attack Complexity", ("L", "H"), "L"),
        "PR": ask_choice("Privileges Required", ("N", "L", "H"), "N"),
        "UI": ask_choice("User Interaction", ("N", "R"), "N"),
        "S": ask_choice("Scope", ("U", "C"), "U"),
        "C": ask_choice("Confidentiality Impact", ("H", "L", "N"), "H"),
        "I": ask_choice("Integrity Impact", ("H", "L", "N"), "H"),
        "A": ask_choice("Availability Impact", ("H", "L", "N"), "L"),
    }
    score = cvss_base_score(vector)
    sev = severity_label(score)
    vector_str = f"CVSS:3.1/AV:{vector['AV']}/AC:{vector['AC']}/PR:{vector['PR']}/UI:{vector['UI']}/S:{vector['S']}/C:{vector['C']}/I:{vector['I']}/A:{vector['A']}"

    print(f"\n[+] CVSS Vector: {vector_str}")
    print(f"[+] CVSS Score : {score}")
    print(f"[+] Severity   : {sev}")
    confirm = ask_choice("Save this finding", ("Y", "N"), "Y")
    if confirm != "Y":
        print("[*] Aborted. Finding not saved.")
        return

    lifecycle.create_record(conn, 'finding', dict(title=title, description=description,
        host=host, cvss_vector=vector_str, cvss_score=score, severity=sev))
    print("[+] Finding saved. Add supporting details with rb-findings details.")


def list_findings(_: argparse.Namespace) -> None:
    conn = connect()
    rows = conn.execute("SELECT * FROM findings ORDER BY cvss_score DESC, id ASC").fetchall()
    if not rows:
        print("[*] No findings recorded.")
        return
    for r in rows:
        print(f"[{r['id']}] {r['title']} | severity={r['severity']} | cvss={r['cvss_score']} | host={r['host'] or '-'}")
        print(f"    vector: {r['cvss_vector']}")
        print(f"    desc  : {r['description']}")


def export_markdown(args: argparse.Namespace) -> None:
    session, engagement_dir, _ = engagement_context()
    conn = connect()
    out_path = export_path(args, engagement_dir, "findings")
    if not args.restricted:
        write_export(out_path, client_draft(conn, "findings"), restricted=False)
        print("[+] Client draft exported; review and complete before delivery.")
        return
    rows = conn.execute("SELECT * FROM findings ORDER BY cvss_score DESC, id ASC").fetchall()
    lines = [f"# Findings - {session}", ""]
    if not rows:
        lines.append("No findings recorded.")
    else:
        for r in rows:
            lines.append(f"## [{r['id']}] {r['title']}")
            lines.append(f"- Severity: {r['severity']}")
            lines.append(f"- CVSS Score: {r['cvss_score']}")
            lines.append(f"- CVSS Vector: `{r['cvss_vector']}`")
            lines.append(f"- Affected Host / Scope Item: {r['host'] or '-'}")
            lines.append("- Description:")
            lines.append(r['description'])
            lines.extend(detail_lines(conn, r['id']))
            lines.append("")
    write_export(out_path, "\n".join(lines), restricted=True)
    print(f"[+] Exported findings markdown: {out_path}")


def finding_details(args: argparse.Namespace) -> None:
    # Validate the complete input before opening/migrating the engagement database.
    document = decode(Path(args.file).read_text(encoding="utf-8")) if args.file else None
    conn = connect()
    if not conn.execute("SELECT 1 FROM findings WHERE id=?", (args.finding_id,)).fetchone():
        fail("Finding not found.")
    if document is not None:
        save_details(conn, args.finding_id, document)
        print("[+] Private finding details saved. Review status does not authorize client export.")
    else:
        print(json.dumps(read_details(conn, args.finding_id), indent=2, ensure_ascii=False))


def update_finding(args):
    changes = {key: value for key, value in {
        'title': args.title, 'description': args.description, 'host': args.host,
        'cvss_vector': args.vector}.items() if value is not None}
    lifecycle.update_record(connect(), 'finding', args.finding_id, changes)
    print('[+] Finding update recorded.')


def retest_finding(args):
    from rb_finding_model import reject_duplicate_keys
    decision = json.loads(Path(args.file).read_text(encoding='utf-8'), object_pairs_hook=reject_duplicate_keys)
    lifecycle.save_details(connect(), args.finding_id, decision, retest_only=True)
    print('[+] Retest decision recorded with history.')


def show_history(args):
    print(json.dumps(lifecycle.history(connect(), 'finding', args.finding_id), indent=2, ensure_ascii=False))


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(description="Red Brixen findings tracker.")
    add_engagement_option(p)
    sub = p.add_subparsers(dest="command", required=True)
    add = sub.add_parser("add", help="Interactively add a finding")
    add.set_defaults(func=interactive_add)
    ls = sub.add_parser("list", help="List findings")
    ls.set_defaults(func=list_findings)
    detail = sub.add_parser("details", help="Show private detail JSON, or replace it from a reviewed local file")
    detail.add_argument("finding_id", type=int)
    detail.add_argument("--file", help="Complete versioned JSON detail document; replaces existing details")
    detail.set_defaults(func=finding_details)
    update = sub.add_parser('update', help='Edit finding fields and retain private history')
    update.add_argument('finding_id', type=int)
    for field in ('title', 'description', 'host', 'vector'):
        update.add_argument('--' + field)
    update.set_defaults(func=update_finding)
    retest = sub.add_parser('retest', help='Record a retest decision from a private JSON file')
    retest.add_argument('finding_id', type=int)
    retest.add_argument('--file', required=True)
    retest.set_defaults(func=retest_finding)
    hist = sub.add_parser('history', help='Display private finding edit and retest history')
    hist.add_argument('finding_id', type=int)
    hist.set_defaults(func=show_history)
    exp = sub.add_parser("export", help="Export findings to markdown")
    add_export_options(exp)
    exp.set_defaults(func=export_markdown)
    return p


def main() -> None:
    parser = build_parser()
    args = parser.parse_args()
    with invocation(args.engagement):
        args.func(args)


if __name__ == "__main__":
    try:
        main()
    except (ValueError, OSError, sqlite3.Error):
        fail("Export or database operation failed; check data, output path and permissions.")
